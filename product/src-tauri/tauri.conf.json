{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Polik Recovery",
  "version": "0.2.0-alpha.1",
  "identifier": "com.polik.recovery",
  "build": {
    "frontendDist": "../apps/desktop-prototype"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "波立克資料救援工作台",
        "width": 1040,
        "height": 720,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 820,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'none'; script-src 'self' 'sha256-i9r8N4e8dftGtbsHaXXaUqe/2fqVAiTjW6+t1FE6FT8='; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "macOS": {
      "entitlements": "entitlements.plist"
    }
  }
}
